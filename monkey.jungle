project.manifest = manifest.xml


# source ############################################################

# default sourcePath is source-modern for newer watches
base.sourcePath = source-modern

# Keep the existing implementation isolated from modern source changes.
d2bravo.sourcePath = source-legacy
d2bravo_titanium.sourcePath = source-legacy
descentg1.sourcePath = source-legacy
fenix3.sourcePath = source-legacy
fenix3_hr.sourcePath = source-legacy
fr230.sourcePath = source-legacy
fr235.sourcePath = source-legacy
fr630.sourcePath = source-legacy
fr735xt.sourcePath = source-legacy
fr920xt.sourcePath = source-legacy
vivoactive.sourcePath = source-legacy
vivoactive_hr.sourcePath = source-legacy
# following watches have been migrated to modern layout via default source-modern
# fenix5.sourcePath = source-legacy
# fenix5x.sourcePath = source-legacy
# fenix6.sourcePath = source-legacy
# fenix6pro.sourcePath = source-legacy
# fenix6xpro.sourcePath = source-legacy
# fenix7.sourcePath = source-legacy
# fenix7x.sourcePath = source-legacy


# resources #########################################################

# default resourcePath has image, good for all devices
base.resourcePath = resources

fr230.resourcePath = $(base.resourcePath);resources-fr230
fr235.resourcePath = $(base.resourcePath);resources-fr235
fr630.resourcePath = $(base.resourcePath);resources-fr630
fr735xt.resourcePath = $(base.resourcePath);resources-fr735xt
fr920xt.resourcePath = $(base.resourcePath);resources-fr920xt
vivoactive.resourcePath = $(base.resourcePath);resources-vivoactive

# included as older watches, but really these are modern watches...
fenix5.resourcePath = $(base.resourcePath);resources-fenix5
fenix5x.resourcePath = $(base.resourcePath);resources-fenix5x
fenix6.resourcePath = $(base.resourcePath);resources-fenix6
fenix6pro.resourcePath = $(base.resourcePath);resources-fenix6pro
fenix6xpro.resourcePath = $(base.resourcePath);resources-fenix6xpro
fenix7.resourcePath = $(base.resourcePath);resources-fenix7
fenix7x.resourcePath = $(base.resourcePath);resources-fenix7x

# Modern resource profiles mapped by geometry after verification.

# round-390x390 devices
approachs7042mm.resourcePath =      $(base.resourcePath);resources-round-390x390
descentmk343mm.resourcePath = 		$(base.resourcePath);resources-round-390x390
epix2pro42mm.resourcePath = 		$(base.resourcePath);resources-round-390x390
marq2.resourcePath = 				$(base.resourcePath);resources-round-390x390
marq2aviator.resourcePath = 		$(base.resourcePath);resources-round-390x390
# d2air
d2air.resourcePath = 				$(base.resourcePath);resources-round-390x390-d2air
venu.resourcePath = 				$(base.resourcePath);resources-round-390x390
venud.resourcePath = 				$(base.resourcePath);resources-round-390x390
# approachs50
approachs50.resourcePath = 			$(base.resourcePath);resources-round-390x390
instinct3amoled45mm.resourcePath = 	$(base.resourcePath);resources-round-390x390
venu3s.resourcePath = 				$(base.resourcePath);resources-round-390x390
vivoactive5.resourcePath = 			$(base.resourcePath);resources-round-390x390
# fr165
fr165.resourcePath = 				$(base.resourcePath);resources-round-390x390-fr165
fr165m.resourcePath = 				$(base.resourcePath);resources-round-390x390-fr165



