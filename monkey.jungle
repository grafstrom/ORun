project.manifest = manifest.xml

##############################################################################################################################
# source #####################################################################################################################

# default sourcePath is source-modern for ALL newer watches
base.sourcePath = source/modern-source

# sourcePath for below legacy devices is source/legacy-source
d2bravo.sourcePath = source/legacy-source
d2bravo_titanium.sourcePath = source/legacy-source
descentg1.sourcePath = source/legacy-source
fenix3.sourcePath = source/legacy-source
fenix3_hr.sourcePath = source/legacy-source
fr230.sourcePath = source/legacy-source
fr235.sourcePath = source/legacy-source
fr630.sourcePath = source/legacy-source
fr735xt.sourcePath = source/legacy-source
fr920xt.sourcePath = source/legacy-source
vivoactive.sourcePath = source/legacy-source
vivoactive_hr.sourcePath = source/legacy-source


##############################################################################################################################
# resources ##################################################################################################################

# default resourcePath has image, good for all devices
base.resourcePath = resources

fr230.resourcePath = $(base.resourcePath);layouts/legacy-layouts/resources-fr230
fr235.resourcePath = $(base.resourcePath);layouts/legacy-layouts/resources-fr235
fr630.resourcePath = $(base.resourcePath);layouts/legacy-layouts/resources-fr630
fr735xt.resourcePath = $(base.resourcePath);layouts/legacy-layouts/resources-fr735xt
fr920xt.resourcePath = $(base.resourcePath);layouts/legacy-layouts/resources-fr920xt
vivoactive.resourcePath = $(base.resourcePath);layouts/legacy-layouts/resources-vivoactive

# included as older watches, but really these are modern watches...
# fenix6.resourcePath = $(base.resourcePath);resources-fenix6
# fenix6pro.resourcePath = $(base.resourcePath);resources-fenix6pro
# fenix6xpro.resourcePath = $(base.resourcePath);resources-fenix6xpro
# fenix7.resourcePath = $(base.resourcePath);resources-fenix7
# fenix7x.resourcePath = $(base.resourcePath);resources-fenix7x





# Modern resource profiles mapped by geometry after verification.

# round-240x240 // g2g
d2charlie.resourcePath = 			$(base.resourcePath);layouts/modern-layouts/resources-round-240x240
