descentmk1.resourcePath = 			$(base.resourcePath);layouts/modern-layouts/resources-round-240x240
fenix5.resourcePath =               $(base.resourcePath);layouts/modern-layouts/resources-round-240x240
fenix5plus.resourcePath = 			$(base.resourcePath);layouts/modern-layouts/resources-round-240x240
fenix5splus.resourcePath = 			$(base.resourcePath);layouts/modern-layouts/resources-round-240x240
fenix5x.resourcePath = 				$(base.resourcePath);layouts/modern-layouts/resources-round-240x240
fenix5xplus.resourcePath = 			$(base.resourcePath);layouts/modern-layouts/resources-round-240x240
